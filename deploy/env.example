# Settings for the online deployment (API on Fly.io, worker on Modal). Never commit real values.
# API and worker need the same database + storage settings.

RALLYIQ_DATABASE_URL=postgresql://USER:PASSWORD@HOST/rallyiq?sslmode=require   # Neon / Supabase
RALLYIQ_STORAGE=s3://rallyiq                                                   # R2 bucket name
RALLYIQ_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RALLYIQ_S3_REGION=auto
AWS_ACCESS_KEY_ID=R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=R2_SECRET_ACCESS_KEY

# API only
RALLYIQ_INVITE_CODE=pick-a-long-random-string      # needed to sign up (RALLYIQ_SIGNUP=invite)
RALLYIQ_WORKER_WAKE_URL=https://WORKSPACE--rallyiq-worker-wake-app.modal.run
RALLYIQ_WORKER_WAKE_TOKEN=another-long-random-string   # same value in the Modal secret
RALLYIQ_CORS_ORIGINS=https://rallyiq.fly.dev

# Optional: AI coach comments via the Claude API (otherwise offline rule templates are used)
# ANTHROPIC_API_KEY=sk-ant-...
