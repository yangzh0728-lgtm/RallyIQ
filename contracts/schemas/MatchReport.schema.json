{
  "$defs": {
    "CoachInsight": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "strength",
            "weakness",
            "pattern",
            "tactic",
            "data_quality"
          ],
          "title": "Kind",
          "type": "string"
        },
        "player_id": {
          "anyOf": [
            {
              "enum": [
                "P1",
                "P2",
                "P3",
                "P4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "evidence": {
          "description": "Metric/Distribution keys from MatchStats that support this insight",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "grounded": {
          "default": true,
          "description": "false if a number in the text was not found in the cited evidence",
          "title": "Grounded",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "title",
        "detail",
        "evidence",
        "confidence"
      ],
      "title": "CoachInsight",
      "type": "object"
    },
    "CoachReport": {
      "additionalProperties": false,
      "description": "LLM (or rule-based) coaching comments. Never a source of truth: every claim\ncites ``MatchStats`` keys and is validated against them.",
      "properties": {
        "schema_version": {
          "default": "0.2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "video_id": {
          "title": "Video Id",
          "type": "string"
        },
        "stats_fingerprint": {
          "title": "Stats Fingerprint",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "language": {
          "const": "zh",
          "default": "zh",
          "title": "Language",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "insights": {
          "items": {
            "$ref": "#/$defs/CoachInsight"
          },
          "title": "Insights",
          "type": "array"
        },
        "training": {
          "items": {
            "$ref": "#/$defs/TrainingItem"
          },
          "title": "Training",
          "type": "array"
        },
        "shot_advice": {
          "description": "shot-by-shot changes, in video order",
          "items": {
            "$ref": "#/$defs/ShotAdvice"
          },
          "title": "Shot Advice",
          "type": "array"
        },
        "self_player": {
          "anyOf": [
            {
              "enum": [
                "P1",
                "P2",
                "P3",
                "P4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the user (\u6211), when known; advice is about them",
          "title": "Self Player"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "why the requested provider was not used",
          "title": "Fallback Reason"
        },
        "dropped": {
          "default": 0,
          "description": "insights removed because they cited no valid evidence",
          "title": "Dropped",
          "type": "integer"
        }
      },
      "required": [
        "video_id",
        "stats_fingerprint",
        "provider",
        "created_at",
        "summary",
        "insights"
      ],
      "title": "CoachReport",
      "type": "object"
    },
    "Distribution": {
      "additionalProperties": false,
      "description": "Counts over named categories (e.g. shot types, court zones, rally lengths).",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "key",
        "label",
        "counts",
        "n",
        "status",
        "confidence"
      ],
      "title": "Distribution",
      "type": "object"
    },
    "MatchStats": {
      "additionalProperties": false,
      "description": "Post-match statistics computed from effective events + player tracks.\n\nPure function of the inputs (no model is called). ``fingerprint`` changes\nwhenever the inputs change, so a cached coach report can be marked stale.",
      "properties": {
        "schema_version": {
          "default": "0.2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "video_id": {
          "title": "Video Id",
          "type": "string"
        },
        "fingerprint": {
          "title": "Fingerprint",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "calibration_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Status"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shot_types_available": {
          "description": "false until a stroke classifier fills ShotEvent.shot_type",
          "title": "Shot Types Available",
          "type": "boolean"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "distributions": {
          "items": {
            "$ref": "#/$defs/Distribution"
          },
          "title": "Distributions",
          "type": "array"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/PlayerStats"
          },
          "title": "Players",
          "type": "array"
        },
        "moments": {
          "description": "shots whose choice should change (singles, needs stroke types + tracks)",
          "items": {
            "$ref": "#/$defs/ShotMoment"
          },
          "title": "Moments",
          "type": "array"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        }
      },
      "required": [
        "video_id",
        "fingerprint",
        "shot_types_available",
        "metrics",
        "players"
      ],
      "title": "MatchStats",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "One computed number with its evidence size and reliability.\n\n``value`` is null when the metric cannot be computed (e.g. no calibration, no\nwinners entered). ``status`` follows the README levels; ``confidence`` is the\nplain-language reliability used by the coach to phrase caveats.",
      "properties": {
        "key": {
          "description": "stable dotted key, e.g. 'P1.movement.distance_m'",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "description": "Chinese display label",
          "title": "Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "n": {
          "description": "sample size the value is computed from",
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "key",
        "label",
        "value",
        "n",
        "status",
        "confidence"
      ],
      "title": "Metric",
      "type": "object"
    },
    "NoteRef": {
      "additionalProperties": false,
      "description": "A coaching-note citation (``knowledge/coaching/notes``). Link and title come from the\nnote file, never from the model, so a citation always points at a real video.",
      "properties": {
        "note_id": {
          "title": "Note Id",
          "type": "string"
        },
        "coach": {
          "title": "Coach",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "description": "source video; with ``t_s`` it opens at that moment",
          "title": "Url",
          "type": "string"
        },
        "t_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "seconds into the video where the cited part starts, when known",
          "title": "T S"
        },
        "drill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name of the note's drill this advice uses, if any",
          "title": "Drill"
        }
      },
      "required": [
        "note_id",
        "coach",
        "title",
        "url"
      ],
      "title": "NoteRef",
      "type": "object"
    },
    "PlayerStats": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "title": "Player Id",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "distributions": {
          "items": {
            "$ref": "#/$defs/Distribution"
          },
          "title": "Distributions",
          "type": "array"
        }
      },
      "required": [
        "player_id",
        "metrics"
      ],
      "title": "PlayerStats",
      "type": "object"
    },
    "ShotAdvice": {
      "additionalProperties": false,
      "description": "Coach advice on one ``ShotMoment``: time, positions and target come from the moment, never the model.",
      "properties": {
        "moment_id": {
          "title": "Moment Id",
          "type": "string"
        },
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "player_id": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "title": "Player Id",
          "type": "string"
        },
        "rally_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rally No"
        },
        "shot_no": {
          "title": "Shot No",
          "type": "integer"
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        },
        "timestamp": {
          "description": "mm:ss (h:mm:ss over an hour) into the video",
          "title": "Timestamp",
          "type": "string"
        },
        "shot_type": {
          "enum": [
            "short_serve",
            "long_serve",
            "clear",
            "smash",
            "drop",
            "net_shot",
            "cross_net",
            "push",
            "net_kill",
            "drive",
            "lift",
            "block"
          ],
          "title": "Shot Type",
          "type": "string"
        },
        "suggested_shot": {
          "anyOf": [
            {
              "enum": [
                "short_serve",
                "long_serve",
                "clear",
                "smash",
                "drop",
                "net_shot",
                "cross_net",
                "push",
                "net_kill",
                "drive",
                "lift",
                "block"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Shot"
        },
        "situation": {
          "description": "what happened: shot, both players' zones (from the moment)",
          "title": "Situation",
          "type": "string"
        },
        "advice": {
          "title": "Advice",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "source": {
          "description": "model = written by the coach provider; rules = rule text",
          "enum": [
            "model",
            "rules"
          ],
          "title": "Source",
          "type": "string"
        },
        "footwork": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the hitter's footwork on this shot (from the moment)",
          "title": "Footwork"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "moment_id",
        "shot_id",
        "player_id",
        "shot_no",
        "t_ms",
        "timestamp",
        "shot_type",
        "situation",
        "advice",
        "why",
        "confidence",
        "source"
      ],
      "title": "ShotAdvice",
      "type": "object"
    },
    "ShotFootwork": {
      "additionalProperties": false,
      "description": "The hitter's footwork for one shot: from the opponent's previous hit to this hit, and the recovery after it.",
      "properties": {
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "player_id": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "title": "Player Id",
          "type": "string"
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        },
        "split_step": {
          "default": "unknown",
          "enum": [
            "on_time",
            "early",
            "late",
            "none",
            "unknown"
          ],
          "title": "Split Step",
          "type": "string"
        },
        "split_offset_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "split-step landing minus the opponent's hit",
          "title": "Split Offset Ms"
        },
        "reaction_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "opponent's hit to the first move towards this shot",
          "title": "Reaction Ms"
        },
        "steps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "steps from the opponent's hit to this hit",
          "title": "Steps"
        },
        "move_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "mid-feet distance covered to reach the shot",
          "title": "Move M"
        },
        "peak_speed_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Speed Mps"
        },
        "pattern": {
          "description": "actions used to reach the shot, in order",
          "items": {
            "enum": [
              "split_step",
              "lunge",
              "jump",
              "chasse",
              "cross_step",
              "run",
              "recovery"
            ],
            "type": "string"
          },
          "title": "Pattern",
          "type": "array"
        },
        "finish": {
          "default": "unknown",
          "enum": [
            "lunge",
            "jump",
            "planted",
            "unknown"
          ],
          "title": "Finish",
          "type": "string"
        },
        "stance_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "distance between the feet at the hit",
          "title": "Stance M"
        },
        "recovery_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "this hit to back within the base radius; null = never",
          "title": "Recovery Ms"
        },
        "recovery_gap_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "distance from base when the opponent hit next",
          "title": "Recovery Gap M"
        },
        "summary": {
          "default": "",
          "description": "one Chinese sentence",
          "title": "Summary",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "shot_id",
        "player_id",
        "t_ms",
        "confidence"
      ],
      "title": "ShotFootwork",
      "type": "object"
    },
    "ShotMoment": {
      "additionalProperties": false,
      "description": "One shot whose choice should change, found by rules from stroke type + both players' positions.\n\nPositions are in each player's own-half frame (``lateral`` from their own left sideline as they\nface the net, ``depth`` from their own baseline: 0 = baseline, 6.70 = net). Zone names for the\nopponent and the target are given from the hitter's point of view (the hitter's left/right).",
      "properties": {
        "moment_id": {
          "title": "Moment Id",
          "type": "string"
        },
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "rally_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rally Id"
        },
        "rally_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based rally number in the video",
          "title": "Rally No"
        },
        "shot_no": {
          "description": "1-based shot number in the rally",
          "minimum": 1,
          "title": "Shot No",
          "type": "integer"
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        },
        "player_id": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "title": "Player Id",
          "type": "string"
        },
        "shot_type": {
          "enum": [
            "short_serve",
            "long_serve",
            "clear",
            "smash",
            "drop",
            "net_shot",
            "cross_net",
            "push",
            "net_kill",
            "drive",
            "lift",
            "block"
          ],
          "title": "Shot Type",
          "type": "string"
        },
        "hitter_zone": {
          "description": "where the hitter stood, e.g. '\u540e\u573a\u5de6\u4fa7' (own view)",
          "title": "Hitter Zone",
          "type": "string"
        },
        "hitter_pos": {
          "description": "hitter (lateral, depth) m, own-half frame",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Hitter Pos",
          "type": "array"
        },
        "opponent_id": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "title": "Opponent Id",
          "type": "string"
        },
        "opponent_zone": {
          "description": "where the opponent stood, from the hitter's view, e.g. '\u7f51\u524d\u53f3\u4fa7'",
          "title": "Opponent Zone",
          "type": "string"
        },
        "opponent_pos": {
          "description": "opponent (lateral, depth) m, opponent's own-half frame",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Opponent Pos",
          "type": "array"
        },
        "opponent_reach_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how far the opponent moved to reach this shot",
          "title": "Opponent Reach M"
        },
        "next_shot_type": {
          "anyOf": [
            {
              "enum": [
                "short_serve",
                "long_serve",
                "clear",
                "smash",
                "drop",
                "net_shot",
                "cross_net",
                "push",
                "net_kill",
                "drive",
                "lift",
                "block"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the opponent's reply",
          "title": "Next Shot Type"
        },
        "outcome": {
          "description": "won/lost = the hitter's side won/lost the rally within the next two shots",
          "enum": [
            "won",
            "lost",
            "continued",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "issue": {
          "description": "rule code, e.g. 'to_opponent', 'clear_to_rear', 'short_to_front'",
          "title": "Issue",
          "type": "string"
        },
        "problem": {
          "title": "Problem",
          "type": "string"
        },
        "suggested_shot": {
          "anyOf": [
            {
              "enum": [
                "short_serve",
                "long_serve",
                "clear",
                "smash",
                "drop",
                "net_shot",
                "cross_net",
                "push",
                "net_kill",
                "drive",
                "lift",
                "block"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Shot"
        },
        "target_zone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "where to send it instead, from the hitter's view",
          "title": "Target Zone"
        },
        "suggestion": {
          "title": "Suggestion",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "severity": {
          "minimum": 0,
          "title": "Severity",
          "type": "number"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "footwork": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShotFootwork"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the hitter's footwork into and out of this shot"
        }
      },
      "required": [
        "moment_id",
        "shot_id",
        "shot_no",
        "t_ms",
        "player_id",
        "shot_type",
        "hitter_zone",
        "hitter_pos",
        "opponent_id",
        "opponent_zone",
        "opponent_pos",
        "outcome",
        "issue",
        "problem",
        "suggestion",
        "why",
        "severity",
        "confidence"
      ],
      "title": "ShotMoment",
      "type": "object"
    },
    "Status": {
      "enum": [
        "ok",
        "needs_review",
        "undeterminable"
      ],
      "title": "Status",
      "type": "string"
    },
    "TrainingItem": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "anyOf": [
            {
              "enum": [
                "P1",
                "P2",
                "P3",
                "P4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "drill": {
          "title": "Drill",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "retest_metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "metric key to compare on the next upload",
          "title": "Retest Metric"
        },
        "focus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the weakness this item addresses, e.g. '\u5931\u5206\u591a\u5728\u7f51\u524d\u7403'",
          "title": "Focus"
        },
        "key_points": {
          "description": "technique points / cues taken from the cited notes",
          "items": {
            "type": "string"
          },
          "title": "Key Points",
          "type": "array"
        },
        "sources": {
          "description": "coaching notes this advice is based on",
          "items": {
            "$ref": "#/$defs/NoteRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "drill",
        "why"
      ],
      "title": "TrainingItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``GET /api/videos/{id}/report``: stats plus the latest coach report, if any.",
  "properties": {
    "stats": {
      "$ref": "#/$defs/MatchStats"
    },
    "coach": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoachReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "coach_stale": {
      "default": false,
      "description": "coach was generated from different stats (e.g. before new corrections)",
      "title": "Coach Stale",
      "type": "boolean"
    }
  },
  "required": [
    "stats"
  ],
  "title": "MatchReport",
  "type": "object"
}
