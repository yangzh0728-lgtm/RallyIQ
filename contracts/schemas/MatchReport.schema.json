{
  "$defs": {
    "CoachInsight": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "strength",
            "weakness",
            "pattern",
            "tactic",
            "data_quality"
          ],
          "title": "Kind",
          "type": "string"
        },
        "player_id": {
          "anyOf": [
            {
              "enum": [
                "P1",
                "P2",
                "P3",
                "P4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "evidence": {
          "description": "Metric/Distribution keys from MatchStats that support this insight",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "grounded": {
          "default": true,
          "description": "false if a number in the text was not found in the cited evidence",
          "title": "Grounded",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "title",
        "detail",
        "evidence",
        "confidence"
      ],
      "title": "CoachInsight",
      "type": "object"
    },
    "CoachReport": {
      "additionalProperties": false,
      "description": "LLM (or rule-based) coaching comments. Never a source of truth: every claim\ncites ``MatchStats`` keys and is validated against them.",
      "properties": {
        "schema_version": {
          "default": "0.2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "video_id": {
          "title": "Video Id",
          "type": "string"
        },
        "stats_fingerprint": {
          "title": "Stats Fingerprint",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "language": {
          "const": "zh",
          "default": "zh",
          "title": "Language",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "insights": {
          "items": {
            "$ref": "#/$defs/CoachInsight"
          },
          "title": "Insights",
          "type": "array"
        },
        "training": {
          "items": {
            "$ref": "#/$defs/TrainingItem"
          },
          "title": "Training",
          "type": "array"
        },
        "shot_advice": {
          "description": "shot-by-shot changes, in video order",
          "items": {
            "$ref": "#/$defs/ShotAdvice"
          },
          "title": "Shot Advice",
          "type": "array"
        },
        "self_player": {
          "anyOf": [
            {
              "enum": [
                "P1",
                "P2",
                "P3",
                "P4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the user (\u6211), when known; advice is about them",
          "title": "Self Player"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "why the requested provider was not used",
          "title": "Fallback Reason"
        },
        "dropped": {
          "default": 0,
          "description": "insights removed because they cited no valid evidence",
          "title": "Dropped",
          "type": "integer"
        }
      },
      "required": [
        "video_id",
        "stats_fingerprint",
        "provider",
        "created_at",
        "summary",
        "insights"
      ],
      "title": "CoachReport",
      "type": "object"
    },
    "Distribution": {
      "additionalProperties": false,
      "description": "Counts over named categories (e.g. shot types, court zones, rally lengths).",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "key",
        "label",
        "counts",
        "n",
        "status",
        "confidence"
      ],
      "title": "Distribution",
      "type": "object"
    },
    "DoublesFinding": {
      "additionalProperties": false,
      "description": "One rule-based observation about a doubles pair (formation, spacing, who takes which shots).",
      "properties": {
        "kind": {
          "enum": [
            "strength",
            "weakness",
            "pattern"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "advice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advice"
        },
        "evidence": {
          "description": "metric / distribution keys",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "detail",
        "confidence"
      ],
      "title": "DoublesFinding",
      "type": "object"
    },
    "DoublesRole": {
      "additionalProperties": false,
      "description": "Where one doubles player plays: mostly at the front, mostly at the back, or rotating.",
      "properties": {
        "player_id": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "title": "Player Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "front",
            "rear",
            "rotating",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        },
        "label": {
          "description": "\u524d\u573a\u578b / \u540e\u573a\u578b / \u8f6e\u8f6c\u578b / \u4e0d\u53ef\u5224\u5b9a",
          "title": "Label",
          "type": "string"
        },
        "front_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "share of front-back moments in which this player was the front one",
          "title": "Front Pct"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "player_id",
        "role",
        "label"
      ],
      "title": "DoublesRole",
      "type": "object"
    },
    "DoublesTeam": {
      "additionalProperties": false,
      "description": "Doubles teamwork of one pair: formation, rotation, spacing, roles and shot division.\n\nThe numbers are ``Metric``s under ``A.dbl.*`` / ``B.dbl.*`` (team, in ``MatchStats.metrics``) and\n``Pn.dbl.*`` (player); \"who takes which shots\" are ``Distribution``s ``<team>.dbl.who.*`` whose\nkeys are listed in ``division``.",
      "properties": {
        "team": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Team",
          "type": "string"
        },
        "players": {
          "items": {
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4"
            ],
            "type": "string"
          },
          "title": "Players",
          "type": "array"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/DoublesRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "division": {
          "description": "distribution keys: who took which shots",
          "items": {
            "type": "string"
          },
          "title": "Division",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/DoublesFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "team",
        "players",
        "status",
        "confidence"
      ],
      "title": "DoublesTeam",
      "type": "object"
    },
    "GameScore": {
      "additionalProperties": false,
      "description": "One game (\u5c40) reconstructed from the entered rally winners (21 points, win by 2, cap 30).",
      "properties": {
        "game_no": {
          "minimum": 1,
          "title": "Game No",
          "type": "integer"
        },
        "score": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Score",
          "type": "object"
        },
        "winner": {
          "anyOf": [
            {
              "enum": [
                "P1",
                "P2",
                "P3",
                "P4"
              ],
              "type": "string"
            },
            {
              "enum": [
                "A",
                "B"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null while the game is unfinished",
          "title": "Winner"
        },
        "rallies": {
          "description": "rallies with a known winner in this game",
          "minimum": 0,
          "title": "Rallies",
          "type": "integer"
        }
      },
      "required": [
        "game_no",
        "score",
        "rallies"
      ],
      "title": "GameScore",
      "type": "object"
    },
    "MatchStats": {
      "additionalProperties": false,
      "description": "Post-match statistics computed from effective events + player tracks.\n\nPure function of the inputs (no model is called). ``fingerprint`` changes\nwhenever the inputs change, so a cached coach report can be marked stale.",
      "properties": {
        "schema_version": {
          "default": "0.2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "video_id": {
          "title": "Video Id",
          "type": "string"
        },
        "fingerprint": {
          "title": "Fingerprint",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "calibration_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Status"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shot_types_available": {
          "description": "false until a stroke classifier fills ShotEvent.shot_type",
          "title": "Shot Types Available",
          "type": "boolean"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "distributions": {
          "items": {
            "$ref": "#/$defs/Distribution"
          },
          "title": "Distributions",
          "type": "array"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/PlayerStats"
          },
          "title": "Players",
          "type": "array"
        },
        "moments": {
          "description": "shots whose choice should change (singles, needs stroke types + tracks)",
          "items": {
            "$ref": "#/$defs/ShotMoment"
          },
          "title": "Moments",
          "type": "array"
        },
        "styles": {
          "description": "playing style per player (singles) or team (doubles); needs stroke types",
          "items": {
            "$ref": "#/$defs/PlayerStyle"
          },
          "title": "Styles",
          "type": "array"
        },
        "doubles": {
          "description": "doubles only: formation, rotation, spacing, roles and shot division per team",
          "items": {
            "$ref": "#/$defs/DoublesTeam"
          },
          "title": "Doubles",
          "type": "array"
        },
        "rallies": {
          "description": "rally log in time order",
          "items": {
            "$ref": "#/$defs/RallyLine"
          },
          "title": "Rallies",
          "type": "array"
        },
        "games": {
          "description": "games reconstructed from entered winners",
          "items": {
            "$ref": "#/$defs/GameScore"
          },
          "title": "Games",
          "type": "array"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        }
      },
      "required": [
        "video_id",
        "fingerprint",
        "shot_types_available",
        "metrics",
        "players"
      ],
      "title": "MatchStats",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "One computed number with its evidence size and reliability.\n\n``value`` is null when the metric cannot be computed (e.g. no calibration, no\nwinners entered). ``status`` follows the README levels; ``confidence`` is the\nplain-language reliability used by the coach to phrase caveats.",
      "properties": {
        "key": {
          "description": "stable dotted key, e.g. 'P1.movement.distance_m'",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "description": "Chinese display label",
          "title": "Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "n": {
          "description": "sample size the value is computed from",
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "key",
        "label",
        "value",
        "n",
        "status",
        "confidence"
      ],
      "title": "Metric",
      "type": "object"
    },
    "NoteRef": {
      "additionalProperties": false,
      "description": "A coaching-note citation (``knowledge/coaching/notes``). Link and title come from the\nnote file, never from the model, so a citation always points at a real video.",
      "properties": {
        "note_id": {
          "title": "Note Id",
          "type": "string"
        },
        "coach": {
          "title": "Coach",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "description": "source video; with ``t_s`` it opens at that moment",
          "title": "Url",
          "type": "string"
        },
        "t_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "seconds into the video where the cited part starts, when known",
          "title": "T S"
        },
        "drill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name of the note's drill this advice uses, if any",
          "title": "Drill"
        }
      },
      "required": [
        "note_id",
        "coach",
        "title",
        "url"
      ],
      "title": "NoteRef",
      "type": "object"
    },
    "PhaseChoice": {
      "additionalProperties": false,
      "description": "What a player did in one attack / neutral / defense state.",
      "properties": {
        "phase": {
          "enum": [
            "attack",
            "neutral",
            "defense"
          ],
          "title": "Phase",
          "type": "string"
        },
        "shots": {
          "minimum": 0,
          "title": "Shots",
          "type": "integer"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "stroke code -> count",
          "title": "Counts",
          "type": "object"
        },
        "recommended_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "share of these shots that were a recommended choice for the state",
          "title": "Recommended Pct"
        }
      },
      "required": [
        "phase",
        "shots"
      ],
      "title": "PhaseChoice",
      "type": "object"
    },
    "PlayerStats": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "title": "Player Id",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "distributions": {
          "items": {
            "$ref": "#/$defs/Distribution"
          },
          "title": "Distributions",
          "type": "array"
        }
      },
      "required": [
        "player_id",
        "metrics"
      ],
      "title": "PlayerStats",
      "type": "object"
    },
    "PlayerStyle": {
      "additionalProperties": false,
      "description": "Playing style of one singles player or one doubles team, from rule-based prototype matching.\n\nFeatures are ``Metric``s under ``<Pn|team>.style.*`` in ``MatchStats`` (cite those as evidence);\nthis object holds the style scores, tactics, attack/neutral/defense choices and next-shot habits.",
      "properties": {
        "subject": {
          "description": "P1/P2 (singles) or A/B (doubles team)",
          "title": "Subject",
          "type": "string"
        },
        "players": {
          "items": {
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4"
            ],
            "type": "string"
          },
          "title": "Players",
          "type": "array"
        },
        "kind": {
          "enum": [
            "singles",
            "doubles"
          ],
          "title": "Kind",
          "type": "string"
        },
        "primary": {
          "anyOf": [
            {
              "$ref": "#/$defs/StyleScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/$defs/StyleScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set when it is within a few points of primary"
        },
        "scores": {
          "description": "every prototype, best first",
          "items": {
            "$ref": "#/$defs/StyleScore"
          },
          "title": "Scores",
          "type": "array"
        },
        "label": {
          "description": "one-line Chinese verdict, e.g. '\u62c9\u540a\u7a81\u51fb\u578b\uff08\u517c\u901f\u5ea6\u62a2\u653b\u578b\uff09' or '\u8bc1\u636e\u4e0d\u8db3'",
          "title": "Label",
          "type": "string"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/PhaseChoice"
          },
          "title": "Phases",
          "type": "array"
        },
        "tactics": {
          "items": {
            "$ref": "#/$defs/TacticUse"
          },
          "title": "Tactics",
          "type": "array"
        },
        "habits": {
          "items": {
            "$ref": "#/$defs/ReplyHabit"
          },
          "title": "Habits",
          "type": "array"
        },
        "evidence": {
          "description": "feature metric keys used",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "advice": {
          "description": "rule advice: execution, state choices, vs this opponent",
          "items": {
            "type": "string"
          },
          "title": "Advice",
          "type": "array"
        },
        "n_shots": {
          "description": "classified non-serve shots the style is based on",
          "minimum": 0,
          "title": "N Shots",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "subject",
        "kind",
        "label",
        "n_shots",
        "status",
        "confidence"
      ],
      "title": "PlayerStyle",
      "type": "object"
    },
    "RallyLine": {
      "additionalProperties": false,
      "description": "One rally of the match as the report lists it (rally log, score flow, tempo).",
      "properties": {
        "rally_no": {
