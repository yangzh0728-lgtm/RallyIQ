{
  "$defs": {
    "Distribution": {
      "additionalProperties": false,
      "description": "Counts over named categories (e.g. shot types, court zones, rally lengths).",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "key",
        "label",
        "counts",
        "n",
        "status",
        "confidence"
      ],
      "title": "Distribution",
      "type": "object"
    },
    "Habit": {
      "additionalProperties": false,
      "description": "One conditional tendency: \"when <condition>, plays <outcome> p of the time\".",
      "properties": {
        "condition": {
          "description": "Chinese, e.g. '\u5728\u540e\u573a\u51fb\u7403\u65f6'",
          "title": "Condition",
          "type": "string"
        },
        "outcome": {
          "description": "Chinese, e.g. '\u6740\u7403'",
          "title": "Outcome",
          "type": "string"
        },
        "p": {
          "title": "P",
          "type": "number"
        },
        "n": {
          "description": "shots matching the condition",
          "title": "N",
          "type": "integer"
        },
        "hits": {
          "title": "Hits",
          "type": "integer"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/HabitEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "counter_examples": {
          "items": {
            "$ref": "#/$defs/HabitEvidence"
          },
          "title": "Counter Examples",
          "type": "array"
        }
      },
      "required": [
        "condition",
        "outcome",
        "p",
        "n",
        "hits",
        "confidence"
      ],
      "title": "Habit",
      "type": "object"
    },
    "HabitEvidence": {
      "additionalProperties": false,
      "properties": {
        "video_id": {
          "title": "Video Id",
          "type": "string"
        },
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "t_ms": {
          "title": "T Ms",
          "type": "integer"
        }
      },
      "required": [
        "video_id",
        "shot_id",
        "t_ms"
      ],
      "title": "HabitEvidence",
      "type": "object"
    },
    "ProfileVideo": {
      "additionalProperties": false,
      "properties": {
        "video_id": {
          "title": "Video Id",
          "type": "string"
        },
        "filename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filename"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "player_id": {
          "anyOf": [
            {
              "enum": [
                "P1",
                "P2",
                "P3",
                "P4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "opponents": {
          "items": {
            "type": "string"
          },
          "title": "Opponents",
          "type": "array"
        },
        "conditions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "object"
        }
      },
      "required": [
        "video_id",
        "recorded_at"
      ],
      "title": "ProfileVideo",
      "type": "object"
    },
    "Status": {
      "enum": [
        "ok",
        "needs_review",
        "undeterminable"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "``GET /api/opponents/{name}``: conditional habits over every committed video of one person.",
  "properties": {
    "schema_version": {
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "person": {
      "title": "Person",
      "type": "string"
    },
    "videos": {
      "items": {
        "$ref": "#/$defs/ProfileVideo"
      },
      "title": "Videos",
      "type": "array"
    },
    "shots": {
      "title": "Shots",
      "type": "integer"
    },
    "typed_shots": {
      "title": "Typed Shots",
      "type": "integer"
    },
    "distributions": {
      "items": {
        "$ref": "#/$defs/Distribution"
      },
      "title": "Distributions",
      "type": "array"
    },
    "habits": {
      "description": "top tendencies, strongest first",
      "items": {
        "$ref": "#/$defs/Habit"
      },
      "title": "Habits",
      "type": "array"
    },
    "next_shot": {
      "description": "reply to my previous shot type -> their next shot",
      "items": {
        "$ref": "#/$defs/Habit"
      },
      "title": "Next Shot",
      "type": "array"
    },
    "caveats": {
      "items": {
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    }
  },
  "required": [
    "person",
    "videos",
    "shots",
    "typed_shots"
  ],
  "title": "OpponentReport",
  "type": "object"
}
