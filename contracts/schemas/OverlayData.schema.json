{
  "$defs": {
    "CourtLines": {
      "additionalProperties": false,
      "description": "Court line segments projected into image px for one calibration segment.",
      "properties": {
        "start_frame": {
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "title": "End Frame",
          "type": "integer"
        },
        "lines": {
          "items": {
            "items": {
              "description": "[x, y]",
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "title": "Lines",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "image_corners": {
          "anyOf": [
            {
              "items": {
                "description": "[x, y]",
                "items": {
                  "type": "number"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "outer corners of the analysed court, near-left, near-right, far-right, far-left",
          "title": "Image Corners"
        },
        "other_courts": {
          "description": "other courts in view (ignored); the UI lets the user switch to one",
          "items": {
            "items": {
              "description": "[x, y]",
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "title": "Other Courts",
          "type": "array"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "lines",
        "status"
      ],
      "title": "CourtLines",
      "type": "object"
    },
    "OverlayFrame": {
      "additionalProperties": false,
      "description": "Everything the web player draws on one frame.\n\nHits/rallies are not repeated here: take them from the effective events\n(``GET /api/videos/{id}/events``) so human corrections show up immediately.",
      "properties": {
        "frame": {
          "title": "Frame",
          "type": "integer"
        },
        "t_ms": {
          "title": "T Ms",
          "type": "integer"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/OverlayPlayer"
          },
          "title": "Players",
          "type": "array"
        },
        "shuttle": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverlayShuttle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "frame",
        "t_ms"
      ],
      "title": "OverlayFrame",
      "type": "object"
    },
    "OverlayPlayer": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "anyOf": [
            {
              "enum": [
                "P1",
                "P2"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Player Id"
        },
        "side": {
          "anyOf": [
            {
              "enum": [
                "near",
                "far"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "bbox": {
          "description": "[x1, y1, x2, y2] px",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox",
          "type": "array"
        },
        "keypoints": {
          "items": {
            "description": "[x, y, conf]",
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "title": "Keypoints",
          "type": "array"
        },
        "foot_court": {
          "anyOf": [
            {
              "description": "[x, y]",
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Foot Court"
        },
        "interpolated": {
          "default": false,
          "title": "Interpolated",
          "type": "boolean"
        }
      },
      "required": [
        "player_id",
        "bbox",
        "keypoints"
      ],
      "title": "OverlayPlayer",
      "type": "object"
    },
    "OverlayShuttle": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "source": {
          "enum": [
            "detected",
            "interpolated"
          ],
          "title": "Source",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "source",
        "confidence"
      ],
      "title": "OverlayShuttle",
      "type": "object"
    },
    "Status": {
      "enum": [
        "ok",
        "needs_review",
        "undeterminable"
      ],
      "title": "Status",
      "type": "string"
    },
    "VideoMeta": {
      "additionalProperties": false,
      "description": "Probe result for an uploaded video (stage ``probe``).",
      "properties": {
        "video_id": {
          "title": "Video Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "fps": {
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "number"
        },
        "frame_count": {
          "minimum": 0,
          "title": "Frame Count",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codec"
        },
        "rotation": {
          "default": 0,
          "title": "Rotation",
          "type": "integer"
        },
        "variable_frame_rate": {
          "default": false,
          "title": "Variable Frame Rate",
          "type": "boolean"
        }
      },
      "required": [
        "video_id",
        "filename",
        "fps",
        "frame_count",
        "width",
        "height",
        "duration_ms"
      ],
      "title": "VideoMeta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Stage ``overlay`` output, served as-is to the web UI.",
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "video": {
      "$ref": "#/$defs/VideoMeta"
    },
    "court": {
      "items": {
        "$ref": "#/$defs/CourtLines"
      },
      "title": "Court",
      "type": "array"
    },
    "keypoint_format": {
      "const": "coco17",
      "default": "coco17",
      "title": "Keypoint Format",
      "type": "string"
    },
    "skeleton": {
      "description": "keypoint index pairs to draw as bones",
      "items": {
        "items": {
          "type": "integer"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "title": "Skeleton",
      "type": "array"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/OverlayFrame"
      },
      "title": "Frames",
      "type": "array"
    }
  },
  "required": [
    "video",
    "frames"
  ],
  "title": "OverlayData",
  "type": "object"
}
