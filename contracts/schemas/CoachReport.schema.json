{
  "$defs": {
    "CoachInsight": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "strength",
            "weakness",
            "pattern",
            "tactic",
            "data_quality"
          ],
          "title": "Kind",
          "type": "string"
        },
        "player_id": {
          "anyOf": [
            {
              "enum": [
                "P1",
                "P2",
                "P3",
                "P4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "evidence": {
          "description": "Metric/Distribution keys from MatchStats that support this insight",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "grounded": {
          "default": true,
          "description": "false if a number in the text was not found in the cited evidence",
          "title": "Grounded",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "title",
        "detail",
        "evidence",
        "confidence"
      ],
      "title": "CoachInsight",
      "type": "object"
    },
    "NoteRef": {
      "additionalProperties": false,
      "description": "A coaching-note citation (``knowledge/coaching/notes``). Link and title come from the\nnote file, never from the model, so a citation always points at a real video.",
      "properties": {
        "note_id": {
          "title": "Note Id",
          "type": "string"
        },
        "coach": {
          "title": "Coach",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "description": "source video; with ``t_s`` it opens at that moment",
          "title": "Url",
          "type": "string"
        },
        "t_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "seconds into the video where the cited part starts, when known",
          "title": "T S"
        },
        "drill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name of the note's drill this advice uses, if any",
          "title": "Drill"
        }
      },
      "required": [
        "note_id",
        "coach",
        "title",
        "url"
      ],
      "title": "NoteRef",
      "type": "object"
    },
    "ShotAdvice": {
      "additionalProperties": false,
      "description": "Coach advice on one ``ShotMoment``: time, positions and target come from the moment, never the model.",
      "properties": {
        "moment_id": {
          "title": "Moment Id",
          "type": "string"
        },
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "player_id": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "title": "Player Id",
          "type": "string"
        },
        "rally_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rally No"
        },
        "shot_no": {
          "title": "Shot No",
          "type": "integer"
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        },
        "timestamp": {
          "description": "mm:ss (h:mm:ss over an hour) into the video",
          "title": "Timestamp",
          "type": "string"
        },
        "shot_type": {
          "enum": [
            "short_serve",
            "long_serve",
            "clear",
            "smash",
            "drop",
            "net_shot",
            "cross_net",
            "push",
            "net_kill",
            "drive",
            "lift",
            "block"
          ],
          "title": "Shot Type",
          "type": "string"
        },
        "suggested_shot": {
          "anyOf": [
            {
              "enum": [
                "short_serve",
                "long_serve",
                "clear",
                "smash",
                "drop",
                "net_shot",
                "cross_net",
                "push",
                "net_kill",
                "drive",
                "lift",
                "block"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Shot"
        },
        "situation": {
          "description": "what happened: shot, both players' zones (from the moment)",
          "title": "Situation",
          "type": "string"
        },
        "advice": {
          "title": "Advice",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "source": {
          "description": "model = written by the coach provider; rules = rule text",
          "enum": [
            "model",
            "rules"
          ],
          "title": "Source",
          "type": "string"
        },
        "footwork": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the hitter's footwork on this shot (from the moment)",
          "title": "Footwork"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "moment_id",
        "shot_id",
        "player_id",
        "shot_no",
        "t_ms",
        "timestamp",
        "shot_type",
        "situation",
        "advice",
        "why",
        "confidence",
        "source"
      ],
      "title": "ShotAdvice",
      "type": "object"
    },
    "TrainingItem": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "anyOf": [
            {
              "enum": [
                "P1",
                "P2",
                "P3",
                "P4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "drill": {
          "title": "Drill",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "retest_metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "metric key to compare on the next upload",
          "title": "Retest Metric"
        },
        "focus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the weakness this item addresses, e.g. '\u5931\u5206\u591a\u5728\u7f51\u524d\u7403'",
          "title": "Focus"
        },
        "key_points": {
          "description": "technique points / cues taken from the cited notes",
          "items": {
            "type": "string"
          },
          "title": "Key Points",
          "type": "array"
        },
        "sources": {
          "description": "coaching notes this advice is based on",
          "items": {
            "$ref": "#/$defs/NoteRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "drill",
        "why"
      ],
      "title": "TrainingItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "LLM (or rule-based) coaching comments. Never a source of truth: every claim\ncites ``MatchStats`` keys and is validated against them.",
  "properties": {
    "schema_version": {
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "video_id": {
      "title": "Video Id",
      "type": "string"
    },
    "stats_fingerprint": {
      "title": "Stats Fingerprint",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "language": {
      "const": "zh",
      "default": "zh",
      "title": "Language",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "insights": {
      "items": {
        "$ref": "#/$defs/CoachInsight"
      },
      "title": "Insights",
      "type": "array"
    },
    "training": {
      "items": {
        "$ref": "#/$defs/TrainingItem"
      },
      "title": "Training",
      "type": "array"
    },
    "shot_advice": {
      "description": "shot-by-shot changes, in video order",
      "items": {
        "$ref": "#/$defs/ShotAdvice"
      },
      "title": "Shot Advice",
      "type": "array"
    },
    "self_player": {
      "anyOf": [
        {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the user (\u6211), when known; advice is about them",
      "title": "Self Player"
    },
    "caveats": {
      "items": {
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "why the requested provider was not used",
      "title": "Fallback Reason"
    },
    "dropped": {
      "default": 0,
      "description": "insights removed because they cited no valid evidence",
      "title": "Dropped",
      "type": "integer"
    }
  },
  "required": [
    "video_id",
    "stats_fingerprint",
    "provider",
    "created_at",
    "summary",
    "insights"
  ],
  "title": "CoachReport",
  "type": "object"
}
