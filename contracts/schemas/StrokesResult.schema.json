{
  "$defs": {
    "ShotStroke": {
      "additionalProperties": false,
      "properties": {
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "stroke": {
          "$ref": "#/$defs/StrokeInfo"
        }
      },
      "required": [
        "shot_id",
        "frame",
        "stroke"
      ],
      "title": "ShotStroke",
      "type": "object"
    },
    "ShotTypeScore": {
      "additionalProperties": false,
      "properties": {
        "shot_type": {
          "enum": [
            "short_serve",
            "long_serve",
            "clear",
            "smash",
            "drop",
            "net_shot",
            "cross_net",
            "push",
            "net_kill",
            "drive",
            "lift",
            "block"
          ],
          "title": "Shot Type",
          "type": "string"
        },
        "p": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P",
          "type": "number"
        }
      },
      "required": [
        "shot_type",
        "p"
      ],
      "title": "ShotTypeScore",
      "type": "object"
    },
    "Source": {
      "enum": [
        "model",
        "human"
      ],
      "title": "Source",
      "type": "string"
    },
    "Status": {
      "enum": [
        "ok",
        "needs_review",
        "undeterminable"
      ],
      "title": "Status",
      "type": "string"
    },
    "StrokeAttr": {
      "additionalProperties": false,
      "description": "One layer of a shot's description, and where it comes from.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "p": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "model probability; null when measured or a rule",
          "title": "P"
        },
        "source": {
          "description": "model = learned from ShuttleSet labels; measured = from tracked positions; rule = a coach's reading of the other layers (no labels exist to learn it)",
          "enum": [
            "model",
            "measured",
            "rule"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "value",
        "source"
      ],
      "title": "StrokeAttr",
      "type": "object"
    },
    "StrokeDetail": {
      "additionalProperties": false,
      "description": "Layered description of a shot on top of its stroke type (see ``rallyiq.strokes.detail``).",
      "properties": {
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "clear smash drop drive block push lift net_shot net_kill serve",
          "title": "Family"
        },
        "subtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cross_court_net_shot, short_serve or long_serve; else null",
          "title": "Subtype"
        },
        "hand": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrokeAttr"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "forehand, backhand or around_head"
        },
        "contact": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrokeAttr"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "high (above the net) or low"
        },
        "direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrokeAttr"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "straight or cross"
        },
        "pace": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrokeAttr"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fast, medium or slow for this family"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrokeAttr"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "attacking, neutral or defensive"
        },
        "intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrokeAttr"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "attack, move, control, defend or transition"
        },
        "description_zh": {
          "default": "",
          "title": "Description Zh",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "attribute model name, e.g. attrs_v1",
          "title": "Source"
        }
      },
      "title": "StrokeDetail",
      "type": "object"
    },
    "StrokeInfo": {
      "additionalProperties": false,
      "description": "Stroke-type prediction (or human label) for one shot.",
      "properties": {
        "shot_type": {
          "anyOf": [
            {
              "enum": [
                "short_serve",
                "long_serve",
                "clear",
                "smash",
                "drop",
                "net_shot",
                "cross_net",
                "push",
                "net_kill",
                "drive",
                "lift",
                "block"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = undeterminable from this video",
          "title": "Shot Type"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "needs_review"
        },
        "source": {
          "$ref": "#/$defs/Source",
          "default": "model"
        },
        "classifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. rules_v1, bst@shuttleset25; null for human",
          "title": "Classifier"
        },
        "candidates": {
          "description": "top candidates, best first",
          "items": {
            "$ref": "#/$defs/ShotTypeScore"
          },
          "title": "Candidates",
          "type": "array"
        },
        "reasons": {
          "description": "review reason codes",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "evidence": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "measured features behind the prediction (null = not measurable)",
          "title": "Evidence",
          "type": "object"
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrokeDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "hand, direction, contact, pace, role, intent"
        }
      },
      "required": [
        "shot_type",
        "confidence"
      ],
      "title": "StrokeInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Stage ``strokes`` output: one stroke prediction per raw ``events`` shot.",
  "properties": {
    "schema_version": {
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "video_id": {
      "title": "Video Id",
      "type": "string"
    },
    "classifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Classifier"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/ShotStroke"
      },
      "title": "Shots",
      "type": "array"
    }
  },
  "required": [
    "video_id",
    "shots"
  ],
  "title": "StrokesResult",
  "type": "object"
}
