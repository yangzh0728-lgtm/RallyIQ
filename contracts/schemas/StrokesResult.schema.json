{
  "$defs": {
    "ShotStroke": {
      "additionalProperties": false,
      "properties": {
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "stroke": {
          "$ref": "#/$defs/StrokeInfo"
        }
      },
      "required": [
        "shot_id",
        "frame",
        "stroke"
      ],
      "title": "ShotStroke",
      "type": "object"
    },
    "ShotTypeScore": {
      "additionalProperties": false,
      "properties": {
        "shot_type": {
          "enum": [
            "short_serve",
            "long_serve",
            "clear",
            "smash",
            "drop",
            "net_shot",
            "cross_net",
            "push",
            "net_kill",
            "drive",
            "lift",
            "block"
          ],
          "title": "Shot Type",
          "type": "string"
        },
        "p": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P",
          "type": "number"
        }
      },
      "required": [
        "shot_type",
        "p"
      ],
      "title": "ShotTypeScore",
      "type": "object"
    },
    "Source": {
      "enum": [
        "model",
        "human"
      ],
      "title": "Source",
      "type": "string"
    },
    "Status": {
      "enum": [
        "ok",
        "needs_review",
        "undeterminable"
      ],
      "title": "Status",
      "type": "string"
    },
    "StrokeInfo": {
      "additionalProperties": false,
      "description": "Stroke-type prediction (or human label) for one shot.",
      "properties": {
        "shot_type": {
          "anyOf": [
            {
              "enum": [
                "short_serve",
                "long_serve",
                "clear",
                "smash",
                "drop",
                "net_shot",
                "cross_net",
                "push",
                "net_kill",
                "drive",
                "lift",
                "block"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = undeterminable from this video",
          "title": "Shot Type"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "needs_review"
        },
        "source": {
          "$ref": "#/$defs/Source",
          "default": "model"
        },
        "classifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. rules_v1, bst@shuttleset25; null for human",
          "title": "Classifier"
        },
        "candidates": {
          "description": "top candidates, best first",
          "items": {
            "$ref": "#/$defs/ShotTypeScore"
          },
          "title": "Candidates",
          "type": "array"
        },
        "reasons": {
          "description": "review reason codes",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "evidence": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "measured features behind the prediction (null = not measurable)",
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "shot_type",
        "confidence"
      ],
      "title": "StrokeInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Stage ``strokes`` output: one stroke prediction per raw ``events`` shot.",
  "properties": {
    "schema_version": {
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "video_id": {
      "title": "Video Id",
      "type": "string"
    },
    "classifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Classifier"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/ShotStroke"
      },
      "title": "Shots",
      "type": "array"
    }
  },
  "required": [
    "video_id",
    "shots"
  ],
  "title": "StrokesResult",
  "type": "object"
}
