{
  "$defs": {
    "CalibrationSegment": {
      "additionalProperties": false,
      "description": "One stable camera pose. A new segment starts when the camera moves/cuts.",
      "properties": {
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "description": "inclusive",
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "homography": {
          "anyOf": [
            {
              "description": "3x3 row-major matrix",
              "items": {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "image px -> court metres; null when calibration failed",
          "title": "Homography"
        },
        "image_corners": {
          "anyOf": [
            {
              "items": {
                "description": "[x, y]",
                "items": {
                  "type": "number"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "outer court corners in px, order: near-left, near-right, far-right, far-left",
          "title": "Image Corners"
        },
        "keypoints": {
          "items": {
            "$ref": "#/$defs/CourtKeypoint"
          },
          "title": "Keypoints",
          "type": "array"
        },
        "reprojection_error_px": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reprojection Error Px"
        },
        "method": {
          "default": "auto",
          "enum": [
            "auto",
            "manual"
          ],
          "title": "Method",
          "type": "string"
        },
        "mirrored": {
          "default": false,
          "title": "Mirrored",
          "type": "boolean"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "needs_review"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "homography"
      ],
      "title": "CalibrationSegment",
      "type": "object"
    },
    "CourtKeypoint": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "e.g. 'near_left_corner', 'net_left_post'",
          "title": "Name",
          "type": "string"
        },
        "image": {
          "description": "[x, y]",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Image",
          "type": "array"
        },
        "court": {
          "description": "[x, y]",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Court",
          "type": "array"
        },
        "used_for_fit": {
          "default": true,
          "title": "Used For Fit",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "image",
        "court"
      ],
      "title": "CourtKeypoint",
      "type": "object"
    },
    "Status": {
      "enum": [
        "ok",
        "needs_review",
        "undeterminable"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Stage ``calibration`` output.",
  "properties": {
    "schema_version": {
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "video_id": {
      "title": "Video Id",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/CalibrationSegment"
      },
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "video_id",
    "segments"
  ],
  "title": "CourtCalibration",
  "type": "object"
}
